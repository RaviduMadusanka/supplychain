<%-- ==========================================================
     Sidebar nav + topbar open. Page must set before including:
       String activePage  (e.g. "dashboard","vendors","products", ...)
       User role and name are read from session (UserDTO) if present, 
       otherwise falls back to local variables.
     Roles: "Admin", "Warehouse Manager", "Vendor"
     ========================================================== --%>
<%
  com.globaltrade.core.dto.UserDTO sessionUser = (com.globaltrade.core.dto.UserDTO) session.getAttribute("user");
  if (sessionUser != null) {
      userName = sessionUser.getFullName();
      userRole = sessionUser.getRole();
  }
%>
<aside class="w-64 bg-sidebar flex-shrink-0 flex flex-col">
  <div class="h-16 flex items-center gap-2 px-5 border-b border-white/10">
    <div class="w-8 h-8 rounded-md bg-primary flex items-center justify-center font-display font-bold text-white text-sm">N</div>
    <div>
      <div class="font-display font-semibold text-white text-sm leading-none">NexTrade SCM</div>
      <% if ("ADMIN".equalsIgnoreCase(userRole)) { %>
      <div class="font-mono text-[10px] text-white/40 tracking-wider mt-1">ADMIN PANEL</div>
      <% } else if ("WAREHOUSE_MANAGER".equalsIgnoreCase(userRole)) { %>
      <div class="font-mono text-[10px] text-white/40 tracking-wider mt-1">WAREHOUSE OPS</div>
      <% } else if ("VENDOR".equalsIgnoreCase(userRole)) { %>
      <div class="font-mono text-[10px] text-white/40 tracking-wider mt-1">VENDOR PORTAL</div>
      <% } else { %>
      <div class="font-mono text-[10px] text-white/40 tracking-wider mt-1">CONTROL TOWER</div>
      <% } %>
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto scrollnice py-2">

    <%-- ===================== ADMIN NAVIGATION ===================== --%>
    <% if ("ADMIN".equalsIgnoreCase(userRole)) { %>

    <div class="navsection">Overview</div>
    <a href="dashboard-admin.jsp" class="navlink <%= "dashboard".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13h4v8H3zM10 3h4v18h-4zM17 8h4v13h-4z"/></svg>
      Dashboard
    </a>

    <div class="navsection">User &amp; Access</div>
    <a href="<%= request.getContextPath() %>/users" class="navlink <%= "users".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      User Management
    </a>
    <a href="<%= request.getContextPath() %>/products" class="navlink <%= "catalog".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      Product Catalog
    </a>
    <a href="system-config.jsp" class="navlink <%= "sysconfig".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3" stroke-width="2"/></svg>
      System Config
    </a>

    <div class="navsection">Monitoring</div>
    <a href="<%= request.getContextPath() %>/monitoring" class="navlink <%= "monitoring".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Audit Logs
    </a>
    <a href="timer-jobs.jsp" class="navlink <%= "timers".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Timer Services
    </a>

    <%-- ===================== WAREHOUSE MANAGER NAVIGATION ===================== --%>
    <% } else if ("WAREHOUSE_MANAGER".equalsIgnoreCase(userRole)) { %>

    <div class="navsection">Overview</div>
    <a href="<%= request.getContextPath() %>/dashboard/warehouse" class="navlink <%= "dashboard".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13h4v8H3zM10 3h4v18h-4zM17 8h4v13h-4z"/></svg>
      Dashboard
    </a>

    <div class="navsection">Inventory</div>
    <a href="<%= request.getContextPath() %>/products" class="navlink <%= "catalog".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      Product Catalog
    </a>
    <a href="<%= request.getContextPath() %>/product/add" class="navlink <%= "addproduct".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Product
    </a>
    <a href="<%= request.getContextPath() %>/inventory" class="navlink <%= "products".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      Stock by Warehouse
    </a>
    <a href="<%= request.getContextPath() %>/warehouses" class="navlink <%= "warehouses".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9.5L12 3l9 6.5V21H3V9.5z"/></svg>
      Warehouses
    </a>

    <div class="navsection">Orders &amp; Logistics</div>
    <a href="<%= request.getContextPath() %>/orders" class="navlink <%= "orders".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Customer Orders
    </a>
    <a href="<%= request.getContextPath() %>/purchase-orders" class="navlink <%= "purchaseorders".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
      Purchase Orders
    </a>
    <div class="navsection">Suppliers</div>
    <a href="<%= request.getContextPath() %>/vendors" class="navlink <%= "vendors".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l8-4v18M13 21V11l6 3v7M9 9h.01M9 12h.01M9 15h.01"/></svg>
      Vendors
    </a>
    <a href="<%= request.getContextPath() %>/vendor-performance" class="navlink <%= "vendorperf".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14"/></svg>
      Vendor Performance
    </a>

    <%-- ===================== VENDOR NAVIGATION ===================== --%>
    <% } else if ("VENDOR".equalsIgnoreCase(userRole)) { %>

    <div class="navsection">Overview</div>
    <a href="dashboard-vendor.jsp" class="navlink <%= "dashboard".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13h4v8H3zM10 3h4v18h-4zM17 8h4v13h-4z"/></svg>
      Dashboard
    </a>

    <div class="navsection">My Business</div>
    <a href="vendor-products.jsp" class="navlink <%= "vendorproducts".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      My Products
    </a>
    <a href="<%= request.getContextPath() %>/purchase-orders" class="navlink <%= "purchaseorders".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Purchase Orders
    </a>

    <div class="navsection">Analytics</div>
    <a href="<%= request.getContextPath() %>/vendor-performance" class="navlink <%= "vendorperf".equals(activePage) ? "active" : "" %> mx-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14"/></svg>
      My Performance
    </a>

    <% } %>

  </nav>

  <div class="p-3 border-t border-white/10">
    <div class="flex items-center gap-2 px-2 py-2 rounded-lg hover:bg-sidebarhov transition">
      <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-semibold font-display flex-shrink-0"><%= userName != null ? userName.substring(0,1) : "U" %></div>
      <div class="min-w-0 flex-1">
        <div class="text-white text-xs font-medium truncate"><%= userName != null ? userName : "User" %></div>
        <div class="text-white/40 text-[10px] font-mono uppercase tracking-wide truncate"><%= userRole != null ? userRole : "" %></div>
      </div>
      <a href="logout" title="Sign out" class="text-white/40 hover:text-white flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      </a>
    </div>
  </div>
</aside>

<div class="flex-1 flex flex-col min-w-0">
  <header class="h-16 bg-sidebar border-b border-white/10 flex items-center justify-between px-8 flex-shrink-0">
    <div>
      <h1 class="font-display font-semibold text-lg text-white"><%= pageTitle %></h1>
      <% if (pageSubtitle != null) { %><p class="text-xs text-white/50 mt-0.5"><%= pageSubtitle %></p><% } %>
    </div>
    <div class="flex items-center gap-3">
      <button class="w-9 h-9 rounded-lg border border-white/20 flex items-center justify-center text-white/60 hover:bg-white/10 transition relative">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-amber"></span>
      </button>
      <div class="h-9 px-3 rounded-lg bg-white/5 border border-white/10 flex items-center gap-2 font-mono text-xs text-white/70">
        <span class="w-1.5 h-1.5 rounded-full bg-teal"></span> SYSTEM NOMINAL
      </div>
    </div>
  </header>
  <main class="flex-1 overflow-y-auto scrollnice p-8">
