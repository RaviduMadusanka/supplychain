<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="SupplyChainPU" transaction-type="JTA">
        <jta-data-source>jdbc/SupplyChainDB</jta-data-source>

        <class>com.globaltrade.core.entity.AuditLog</class>
        <class>com.globaltrade.core.entity.Customer</class>
        <class>com.globaltrade.core.entity.CustomsDocument</class>
        <class>com.globaltrade.core.entity.ExceptionLog</class>
        <class>com.globaltrade.core.entity.InventoryAlert</class>
        <class>com.globaltrade.core.entity.InventoryItem</class>
        <class>com.globaltrade.core.entity.InventoryStock</class>
        <class>com.globaltrade.core.entity.Order</class>
        <class>com.globaltrade.core.entity.OrderItem</class>
        <class>com.globaltrade.core.entity.RouteOptimizationLog</class>
        <class>com.globaltrade.core.entity.Shipment</class>
        <class>com.globaltrade.core.entity.Status</class>
        <class>com.globaltrade.core.entity.ShipmentItem</class>
        <class>com.globaltrade.core.entity.TimerJob</class>
        <class>com.globaltrade.core.entity.TransactionAudit</class>
        <class>com.globaltrade.core.entity.User</class>
        <class>com.globaltrade.core.entity.Vendor</class>
        <class>com.globaltrade.core.entity.VendorPerformance</class>
        <class>com.globaltrade.core.entity.Warehouse</class>
        <class>com.globaltrade.core.entity.Country</class>
        <class>com.globaltrade.core.entity.Category</class>
        <class>com.globaltrade.core.entity.OrderStatus</class>
        <class>com.globaltrade.core.entity.AccountStatus</class>
        <class>com.globaltrade.core.entity.Role</class>
        <class>com.globaltrade.core.entity.Company</class>
        <class>com.globaltrade.core.entity.CustomsStatus</class>
        <class>com.globaltrade.core.entity.ShipmentStatus</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
